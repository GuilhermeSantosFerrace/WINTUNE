<Project>
  <!-- Configuração comum a todos os projetos da solução WinTune. -->
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Fase 14: conjunto "Recommended" dos analisadores .NET como erro no código de produção (src/). -->
    <AnalysisMode Condition="$(MSBuildProjectDirectory.Contains('\src\'))">Recommended</AnalysisMode>
    <Deterministic>true</Deterministic>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>

    <VersionPrefix>1.0.0</VersionPrefix>
    <Company>WinTune</Company>
    <Product>WinTune</Product>
    <Copyright>Copyright (c) WinTune contributors</Copyright>
  </PropertyGroup>
</Project>
