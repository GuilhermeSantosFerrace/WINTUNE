<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Contraste: texto #F2F2F2 sobre #202020 (~15:1); texto secundário #C5C5C5 (~10:1). -->
  <SolidColorBrush x:Key="Brush.Window" Color="#202020" />
  <SolidColorBrush x:Key="Brush.Panel" Color="#2B2B2B" />
  <SolidColorBrush x:Key="Brush.Text" Color="#F2F2F2" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C5C5C5" />
  <SolidColorBrush x:Key="Brush.Border" Color="#555555" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#60CDFF" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#000000" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#FFC94D" />
  <SolidColorBrush x:Key="Brush.Critical" Color="#FF99A4" />
  <SolidColorBrush x:Key="Brush.Info" Color="#60CDFF" />
</ResourceDictionary>
