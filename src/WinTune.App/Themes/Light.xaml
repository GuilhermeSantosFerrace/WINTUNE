<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Contraste: texto #1B1B1B sobre #F3F3F3 (~16:1); texto secundário #4A4A4A (~8:1). -->
  <SolidColorBrush x:Key="Brush.Window" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Text" Color="#1B1B1B" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#4A4A4A" />
  <SolidColorBrush x:Key="Brush.Border" Color="#C8C8C8" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#005FB8" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#8A5300" />
  <SolidColorBrush x:Key="Brush.Critical" Color="#B00020" />
  <SolidColorBrush x:Key="Brush.Info" Color="#005FB8" />
</ResourceDictionary>
