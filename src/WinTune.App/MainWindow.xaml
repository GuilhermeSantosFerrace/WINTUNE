<Window x:Class="WinTune.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinTune.Presentation.ViewModels;assembly=WinTune.Presentation"
        Title="{DynamicResource Str.AppTitle}"
        Width="1100" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        AutomationProperties.Name="WinTune - janela principal">
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding AnalyzeCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <!-- Cabeçalho -->
    <Border DockPanel.Dock="Top" Padding="16,12" Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="{DynamicResource Str.AppTitle}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Str.Tagline}" Style="{StaticResource Secondary}" />
      </StackPanel>
    </Border>

    <!-- Barra de status -->
    <Border DockPanel.Dock="Bottom" Padding="16,8" Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="{DynamicResource Str.Cancel}" Margin="8,0,0,0"
                Command="{Binding CancelCommand}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Cancelar operação em andamento" />
        <ProgressBar DockPanel.Dock="Right" Width="220" Height="14" Minimum="0" Maximum="100"
                     Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                     AutomationProperties.Name="Progresso" />
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status" />
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs" Margin="8" AutomationProperties.Name="Seções do WinTune">
      <!-- ====================== Otimizar ====================== -->
      <TabItem Header="{DynamicResource Str.Tab.Optimize}" AutomationProperties.Name="Otimizar">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel IsEnabled="{Binding IsIdle}">
              <GroupBox Header="{DynamicResource Str.Focus}">
                <StackPanel>
                  <RadioButton GroupName="Focus" Content="{DynamicResource Str.Focus.Work}" IsChecked="{Binding IsWorkFocus}" AutomationProperties.Name="Foco: Trabalho" />
                  <RadioButton GroupName="Focus" Content="{DynamicResource Str.Focus.Gaming}" IsChecked="{Binding IsGamingFocus}" AutomationProperties.Name="Foco: Jogos" />
                  <RadioButton GroupName="Focus" Content="{DynamicResource Str.Focus.Both}" IsChecked="{Binding IsBothFocus}" AutomationProperties.Name="Foco: Os dois" />
                </StackPanel>
              </GroupBox>

              <GroupBox Header="{DynamicResource Str.Games}"
                        Visibility="{Binding IsGamesSectionVisible, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding IsGamesSectionVisible}">
                <StackPanel>
                  <CheckBox Content="{DynamicResource Str.Games.Siege}" IsChecked="{Binding SiegeSelected}" AutomationProperties.Name="Otimizar para Rainbow Six Siege" />
                  <CheckBox Content="{DynamicResource Str.Games.Cs2}" IsChecked="{Binding Cs2Selected}" AutomationProperties.Name="Otimizar para Counter-Strike 2" />
                </StackPanel>
              </GroupBox>

              <GroupBox Header="{DynamicResource Str.Scenarios}">
                <ItemsControl ItemsSource="{Binding Scenarios}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScenarioOption}">
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </GroupBox>

              <TextBlock Text="{DynamicResource Str.Privacy}" Style="{StaticResource Secondary}" Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>

          <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="{DynamicResource Str.Analyze}" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}"
                      AutomationProperties.Name="Analisar o sistema" ToolTip="Lê o estado do sistema sem alterar nada (F5)" />
              <Button Content="{DynamicResource Str.Apply}" Command="{Binding ApplySelectedCommand}"
                      AutomationProperties.Name="Aplicar ajustes selecionados" ToolTip="Mostra o que será alterado e pede confirmação" />
              <Button Content="{DynamicResource Str.UndoAll}" Command="{Binding UndoAllCommand}"
                      AutomationProperties.Name="Desfazer todos os ajustes" ToolTip="Restaura o estado original de tudo que o WinTune alterou" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str.Recommended}" Style="{StaticResource SectionHeader}" />
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str.Recommended.Empty}" Style="{StaticResource Secondary}" Margin="0,0,0,8" />

            <ListBox ItemsSource="{Binding Recommendations}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue"
                     AutomationProperties.Name="Ajustes recomendados">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                  <Grid Margin="4,6" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,8,0" IsChecked="{Binding IsSelected}"
                              AutomationProperties.Name="{Binding Name, StringFormat=Selecionar {0}}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                        <Run Text="{Binding Name, Mode=OneWay}" />
                        <Run Text="  ·  " Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Run Text="{Binding RiskText, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Run Text="  ·  " Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" FontFamily="Consolas" FontSize="11">
                        <Run Text="{DynamicResource Str.Where}" />
                        <Run Text="{Binding Mechanism, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ====================== Diagnóstico ====================== -->
      <TabItem Header="{DynamicResource Str.Tab.Diagnostics}" AutomationProperties.Name="Diagnóstico">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str.Diagnostics.Intro}" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SystemFindings}" ItemTemplate="{StaticResource FindingTemplate}" />
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ====================== Jogos ====================== -->
      <TabItem Header="{DynamicResource Str.Tab.Games}" AutomationProperties.Name="Jogos">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str.Games.Intro}" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GameFindings}" ItemTemplate="{StaticResource FindingTemplate}" />
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ====================== Telemetria ====================== -->
      <TabItem Header="{DynamicResource Str.Tab.Telemetry}" AutomationProperties.Name="Telemetria" DataContext="{Binding Telemetry}">
        <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,8"
                       Text="Monitor ao vivo com fontes em modo usuário (contadores do Windows, NVML e WMI): seguro com jogos com anti-cheat abertos. Nada é gravado fora deste PC." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="Iniciar _monitor" Command="{Binding StartMonitoringCommand}" AutomationProperties.Name="Iniciar monitor ao vivo" />
              <Button Content="_Parar monitor" Command="{Binding StopMonitoringCommand}" AutomationProperties.Name="Parar monitor ao vivo" />
            </StackPanel>
            <TextBlock Text="{Binding UnavailableText}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasUnavailable, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{Binding CpuText}" AutomationProperties.LiveSetting="Off" />
                <TextBlock Text="{Binding GpuText}" />
                <TextBlock Text="{Binding RamText}" />
                <TextBlock Text="{Binding DiskText}" />
                <WrapPanel Margin="0,8,0,0">
                  <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="CPU (%)" Style="{StaticResource Secondary}" />
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Width="362" Height="82">
                      <Canvas Width="360" Height="80" AutomationProperties.Name="Gráfico de uso de CPU">
                        <Polyline Points="{Binding CpuSeries, Converter={StaticResource SeriesToPoints}}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" />
                      </Canvas>
                    </Border>
                  </StackPanel>
                  <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="GPU (%)" Style="{StaticResource Secondary}" />
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Width="362" Height="82">
                      <Canvas Width="360" Height="80" AutomationProperties.Name="Gráfico de uso de GPU">
                        <Polyline Points="{Binding GpuSeries, Converter={StaticResource SeriesToPoints}}" Stroke="{DynamicResource Brush.Warning}" StrokeThickness="1.5" />
                      </Canvas>
                    </Border>
                  </StackPanel>
                  <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="RAM (%)" Style="{StaticResource Secondary}" />
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Width="362" Height="82">
                      <Canvas Width="360" Height="80" AutomationProperties.Name="Gráfico de uso de RAM">
                        <Polyline Points="{Binding RamSeries, Converter={StaticResource SeriesToPoints}}" Stroke="{DynamicResource Brush.Critical}" StrokeThickness="1.5" />
                      </Canvas>
                    </Border>
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="Sessão de diagnóstico" Style="{StaticResource SectionHeader}" Margin="0,8,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="Duração (min):" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Width="60" Text="{Binding SessionMinutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Duração da sessão em minutos" Margin="0,0,8,0" />
              <Button Content="Iniciar _sessão de diagnóstico" Style="{StaticResource PrimaryButton}" Command="{Binding StartSessionCommand}" AutomationProperties.Name="Iniciar sessão de diagnóstico" />
              <Button Content="_Encerrar sessão" Command="{Binding StopSessionCommand}" AutomationProperties.Name="Encerrar sessão de diagnóstico" />
            </StackPanel>
            <TextBlock Text="{Binding SessionStatus}" Style="{StaticResource Secondary}" />
            <TextBlock Text="{Binding SessionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,4" AutomationProperties.LiveSetting="Polite" />
            <ItemsControl ItemsSource="{Binding Evidence}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource Secondary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding SessionFindings}" ItemTemplate="{StaticResource FindingTemplate}" Margin="0,8,0,0" />

            <TextBlock Text="Consumidores em segundo plano" Style="{StaticResource SectionHeader}" Margin="0,8,0,8" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,8"
                       Text="O WinTune nunca finaliza processos: só mostra quem consome e sugere fechar o que não usa durante o jogo. Os processos dos jogos são excluídos da análise." />
            <Button Content="_Atualizar lista" HorizontalAlignment="Left" Command="{Binding RefreshConsumersCommand}" Margin="0,0,0,8" AutomationProperties.Name="Atualizar consumidores em segundo plano" />
            <DataGrid ItemsSource="{Binding Consumers}" IsReadOnly="True" MaxHeight="300" AutomationProperties.Name="Consumidores em segundo plano">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="*" />
                <DataGridTextColumn Header="Memória privada" Binding="{Binding Memory}" Width="*" />
                <DataGridTextColumn Header="Tipo conhecido" Binding="{Binding Category}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ====================== Inicialização ====================== -->
      <TabItem Header="{DynamicResource Str.Tab.Startup}" AutomationProperties.Name="Inicialização" DataContext="{Binding Startup}">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,8"
                       Text="Itens que abrem no login. Nada é removido: desativar usa o mesmo mecanismo do Gerenciador de Tarefas e pode ser revertido. Itens da Microsoft, de segurança e de drivers ficam protegidos." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="_Atualizar" Command="{Binding RefreshCommand}" AutomationProperties.Name="Atualizar lista de inicialização" />
              <Button Content="_Desativar selecionados" Command="{Binding DisableSelectedCommand}" AutomationProperties.Name="Desativar itens selecionados" />
              <Button Content="_Reativar selecionados" Command="{Binding ReenableSelectedCommand}" AutomationProperties.Name="Reativar itens desativados pelo WinTune" />
            </StackPanel>
            <CheckBox IsChecked="{Binding AllowDisable}" Margin="0,0,0,8" AutomationProperties.Name="Permitir desativar itens (experimental)">
              <TextBlock TextWrapping="Wrap" Text="Permitir desativar (experimental): o formato usado pelo Gerenciador de Tarefas não tem documentação oficial. Depois de desativar um item, confira no Gerenciador de Tarefas &gt; Aplicativos de inicialização se o estado é o mesmo." />
            </CheckBox>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding Items}" AutomationProperties.Name="Itens de inicialização">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Sel." Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
              <DataGridTextColumn Header="Nome" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
              <DataGridTextColumn Header="Origem" Binding="{Binding Source}" IsReadOnly="True" Width="2*" />
              <DataGridTextColumn Header="Editor" Binding="{Binding Publisher}" IsReadOnly="True" Width="2*" />
              <DataGridTextColumn Header="Impacto" Binding="{Binding Impact}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="Estado" Binding="{Binding State}" IsReadOnly="True" Width="2*" />
              <DataGridTextColumn Header="Observação" Binding="{Binding Notes}" IsReadOnly="True" Width="3*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ====================== Limpeza ====================== -->
      <TabItem Header="{DynamicResource Str.Tab.Cleanup}" AutomationProperties.Name="Limpeza" DataContext="{Binding Cleanup}">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Irreversible, Mode=OneTime}" Foreground="{DynamicResource Brush.Critical}" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Categories}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CleanupCategoryViewModel}">
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewSize}" FontWeight="SemiBold" />
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}" />
                      </DockPanel>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="22,2,0,0" />
                      <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="22,2,0,0"
                                 Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
              <Button Content="_Gerar prévia" Style="{StaticResource PrimaryButton}" Command="{Binding PreviewCommand}" AutomationProperties.Name="Gerar prévia da limpeza" />
              <Button Content="_Limpar (irreversível)" Command="{Binding CleanCommand}" AutomationProperties.Name="Executar limpeza, irreversível" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="Ignorados e motivo:" Style="{StaticResource Secondary}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Skipped}" AutomationProperties.Name="Arquivos ignorados" />
        </DockPanel>
      </TabItem>

      <!-- ====================== Registro ====================== -->
      <TabItem Header="{DynamicResource Str.Tab.Log}" AutomationProperties.Name="Registro de operações">
        <ListBox Margin="12" ItemsSource="{Binding Log}" AutomationProperties.Name="Registro de operações" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
