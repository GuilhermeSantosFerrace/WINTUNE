<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WinTune.App</RootNamespace>
    <AssemblyName>WinTune</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Aplicativo (não biblioteca): XML docs opcionais em code-behind. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTune.Presentation\WinTune.Presentation.csproj" />
    <ProjectReference Include="..\WinTune.Platform\WinTune.Platform.csproj" />
  </ItemGroup>

</Project>
