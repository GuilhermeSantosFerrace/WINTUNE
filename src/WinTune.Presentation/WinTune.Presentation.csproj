<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WinTune.Presentation</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- ViewModels: membros gerados pelo CommunityToolkit não têm XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinTune.Presentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTune.Core\WinTune.Core.csproj" />
  </ItemGroup>

</Project>
